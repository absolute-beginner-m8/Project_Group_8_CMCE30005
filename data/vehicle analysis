class DataLoader:
    """Handle data loading and aggregation from R workflow"""
    
    @staticmethod
    def load_transfers():
        """Load transfers data from raw monthly file and aggregate"""
        try:
            # Load raw monthly transfers file
            if not Config.RAW_TRANSFERS_FILE.exists():
                raise FileNotFoundError(f"Raw transfers file not found: {Config.RAW_TRANSFERS_FILE}")
            
            print(f"ℹ Loading raw transfers data from: {Config.RAW_TRANSFERS_FILE.name}")
            df = pd.read_csv(Config.RAW_TRANSFERS_FILE)
            
            # Convert data_month_year (YYYYMM) to proper date
            df['date'] = pd.to_datetime(df['data_month_year'], format='%Y%m')
            
            # Aggregate to monthly totals
            monthly = df.groupby('date')['TOTAL'].sum().sort_index()
            
            print(f"✓ Loaded transfers: {len(df):,} records")
            print(f"  Monthly observations: {len(monthly)}")
            print(f"  Date range: {monthly.index.min().date()} to {monthly.index.max().date()}")
            
            return monthly, df
        
        except FileNotFoundError as e:
            print(f"✗ Error: {e}")
            print(f"  Make sure raw data files are in {Config.RAW_DATA_DIR}/")
            raise
        except Exception as e:
            print(f"✗ Error processing transfers data: {e}")
            raise
    
    @staticmethod
    def load_by_make(df, top_n=5):
        """Load monthly time series by individual makes"""
        # Clean make names (strip whitespace)
        df['make_clean'] = df['CD_MAKE_VEH'].str.strip()
        
        # Get top makes by volume
        makes_volumes = df.groupby('make_clean')['TOTAL'].sum().nlargest(top_n)
        
        by_make = {}
        for make in makes_volumes.index:
            make_data = df[df['make_clean'] == make]
            monthly = make_data.groupby('date')['TOTAL'].sum().sort_index()
            by_make[make] = monthly
        
        return by_make


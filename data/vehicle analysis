class XGBoostForecaster:
    """XGBoost with engineered lag features"""
    
    def __init__(self, params=None):
        self.params = params or Config.XGBOOST_PARAMS
        self.model = None
        self.scaler = StandardScaler()
        self.history = {}
        self.feature_importance = None
    
    @staticmethod
    def create_lag_features(series, lags=[1, 3, 6, 12], n_ahead=1):
        """Create lagged features for ML model"""
        data = series.values
        X, y = [], []
        
        for i in range(len(series) - max(lags) - n_ahead):
            features = [data[i + max(lags) - lag] for lag in lags]
            target = data[i + max(lags) + n_ahead - 1]
            X.append(features)
            y.append(target)
        
        return np.array(X), np.array(y)
    
    def fit(self, train_series):
        """Fit XGBoost model"""
        X, y = self.create_lag_features(train_series)
        
        # Normalize features
        X_scaled = self.scaler.fit_transform(X)
        
        self.model = xgb.XGBRegressor(**self.params)
        self.model.fit(X_scaled, y, verbose=False)
        
        # Store feature importance
        self.feature_importance = self.model.feature_importances_
        
        print(f"  ✓ XGBoost model fitted ({len(X)} training samples)")
        return self.model
    
    def forecast(self, series, steps):
        """Generate forecast using recursive prediction"""
        forecast = []
        history = series.copy()
        
        for _ in range(steps):
            # Get lag features from history
            lags = [1, 3, 6, 12]
            features = np.array([
                [history.values[-(lag)] for lag in lags]
            ])
            
            # Normalize and predict
            features_scaled = self.scaler.transform(features)
            pred = self.model.predict(features_scaled)[0]
            forecast.append(pred)
            
            # Add prediction to history for next iteration
            history = pd.concat([
                history,
                pd.Series([pred], index=[history.index[-1] + pd.DateOffset(months=1)])
            ])
        
        return np.array(forecast)
    
    def backtest_walk_forward(self, series, window=6):
        """Walk-forward backtest"""
        print(f"\n📊 XGBoost Walk-Forward Backtest (window={window}m)...")
        
        predictions = []
        actuals = []
        
        n_obs = len(series)
        n_tests = (n_obs - 24) // window  # Need 24 months for lag features
        
        for i in range(n_tests):
            train_end = 24 + (i * window)
            test_start = train_end
            test_end = test_start + window
            
            if test_end > n_obs:
                break
            
            train = series[:train_end]
            test = series[test_start:test_end]
            
            try:
                xgb_model = XGBoostForecaster(self.params)
                xgb_model.fit(train)
                pred = xgb_model.forecast(train, window)
                
                predictions.extend(pred)
                actuals.extend(test.values)
            except:
                continue
        
        if predictions:
            mae = mean_absolute_error(actuals, predictions)
            rmse = np.sqrt(mean_squared_error(actuals, predictions))
            mape = mean_absolute_percentage_error(actuals, predictions)
            
            self.history['backtest'] = {
                'mae': mae,
                'rmse': rmse,
                'mape': mape,
                'n_predictions': len(predictions)
            }
            
            print(f"  MAE: {mae:.0f} | RMSE: {rmse:.0f} | MAPE: {mape:.2%}")
        
        return predictions, actuals


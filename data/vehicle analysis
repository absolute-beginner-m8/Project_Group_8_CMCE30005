class ModelEnsemble:
    """Compare and combine multiple models"""
    
    def __init__(self):
        self.models = {}
        self.test_results = {}
    
    def train_and_evaluate(self, series, test_split=0.7):
        """Train all models and evaluate on test set"""
        
        split_point = int(len(series) * test_split)
        train_series = series[:split_point]
        test_series = series[split_point:]
        
        print("\n" + "="*70)
        print("TRAINING & EVALUATING ALL MODELS")
        print("="*70)
        
        # 1. ARIMA
        print("\n1️⃣  ARIMA")
        try:
            arima = ARIMAForecaster(auto_optimize=True)
            arima.fit(train_series)
            arima_pred, arima_ci = arima.forecast(len(test_series))
            
            arima_mae = mean_absolute_error(test_series, arima_pred)
            arima_rmse = np.sqrt(mean_squared_error(test_series, arima_pred))
            arima_mape = mean_absolute_percentage_error(test_series, arima_pred)
            
            self.models['ARIMA'] = arima
            self.test_results['ARIMA'] = {
                'mae': arima_mae,
                'rmse': arima_rmse,
                'mape': arima_mape,
                'predictions': arima_pred
            }
            print(f"  ✓ MAE: {arima_mae:.0f} | RMSE: {arima_rmse:.0f} | MAPE: {arima_mape:.2%}")
        except Exception as e:
            print(f"  ✗ Failed: {e}")
        
        # 2. PROPHET
        print("\n2️⃣  PROPHET")
        try:
            prophet = ProphetForecaster()
            prophet.fit(train_series)
            prophet_pred, _, _ = prophet.forecast(len(test_series))
            
            prophet_mae = mean_absolute_error(test_series, prophet_pred)
            prophet_rmse = np.sqrt(mean_squared_error(test_series, prophet_pred))
            prophet_mape = mean_absolute_percentage_error(test_series, prophet_pred)
            
            self.models['Prophet'] = prophet
            self.test_results['Prophet'] = {
                'mae': prophet_mae,
                'rmse': prophet_rmse,
                'mape': prophet_mape,
                'predictions': prophet_pred
            }
            print(f"  ✓ MAE: {prophet_mae:.0f} | RMSE: {prophet_rmse:.0f} | MAPE: {prophet_mape:.2%}")
        except Exception as e:
            print(f"  ✗ Failed: {e}")
        
        # 3. XGBOOST
        print("\n3️⃣  XGBOOST")
        try:
            xgboost = XGBoostForecaster()
            xgboost.fit(train_series)
            xgboost_pred = xgboost.forecast(train_series, len(test_series))
            
            xgboost_mae = mean_absolute_error(test_series, xgboost_pred)
            xgboost_rmse = np.sqrt(mean_squared_error(test_series, xgboost_pred))
            xgboost_mape = mean_absolute_percentage_error(test_series, xgboost_pred)
            
            self.models['XGBoost'] = xgboost
            self.test_results['XGBoost'] = {
                'mae': xgboost_mae,
                'rmse': xgboost_rmse,
                'mape': xgboost_mape,
                'predictions': xgboost_pred
            }
            print(f"  ✓ MAE: {xgboost_mae:.0f} | RMSE: {xgboost_rmse:.0f} | MAPE: {xgboost_mape:.2%}")
        except Exception as e:
            print(f"  ✗ Failed: {e}")
        
        return train_series, test_series
    
    def ensemble_forecast(self, steps, weights=None):
        """Combine forecasts from all models (simple average)"""
        if weights is None:
            weights = {model: 1/len(self.models) for model in self.models}
        
        ensemble_pred = np.zeros(steps)
        
        for model_name, model in self.models.items():
            if model_name == 'ARIMA':
                pred, _ = model.forecast(steps)
            elif model_name == 'Prophet':
                pred, _, _ = model.forecast(steps)
            elif model_name == 'XGBoost':
                # Need series to forecast from - use last training series
                pred = model.forecast(model.series, steps)
            
            ensemble_pred += pred * weights[model_name]
        
        return ensemble_pred
    
    def get_comparison_table(self):
        """Return model comparison as DataFrame"""
        comparison = []
        
        for model_name, results in self.test_results.items():
            comparison.append({
                'Model': model_name,
                'MAE': round(results['mae'], 0),
                'RMSE': round(results['rmse'], 0),
                'MAPE': f"{results['mape']:.2%}",
                'Best': '✓' if results['mae'] == min(r['mae'] for r in self.test_results.values()) else ''
            })
        
        return pd.DataFrame(comparison).sort_values('MAE')


    decomp = TimeSeriesDiagnostics.decompose_series(monthly_series)
    
    # Train & evaluate all models
    print("\n" + "="*70)
    ensemble = ModelEnsemble()
    train_series, test_series = ensemble.train_and_evaluate(monthly_series, test_split=Config.TEST_SPLIT)
    
    # Compare models
    print("\n" + "="*70)
    print("MODEL COMPARISON (Test Set Performance)")
    print("="*70)
    comparison_df = ensemble.get_comparison_table()
    print("\n" + comparison_df.to_string(index=False))
    comparison_df.to_csv(Config.RESULTS_DIR / 'phase3_model_comparison.csv', index=False)
    
    # Future forecast with best model
    print("\n" + "="*70)
    print(f"FUTURE FORECAST ({Config.FORECAST_HORIZON} months)")
    print("="*70)
    
    best_model_name = comparison_df.iloc[0]['Model']
    best_model = ensemble.models[best_model_name]
    
    if best_model_name == 'ARIMA':
        forecast, conf = best_model.forecast(Config.FORECAST_HORIZON)
    elif best_model_name == 'Prophet':
        forecast, conf_lower, conf_upper = best_model.forecast(Config.FORECAST_HORIZON)
        conf = pd.DataFrame({'lower': conf_lower, 'upper': conf_upper})
    
    future_dates = pd.date_range(start=monthly_series.index[-1] + pd.DateOffset(months=1),
                                periods=Config.FORECAST_HORIZON, freq='MS')
    
    forecast_df = pd.DataFrame({
        'date': future_dates,
        'forecast': forecast,
        'ci_lower': conf.iloc[:, 0] if 'lower' not in conf.columns else conf['lower'],
        'ci_upper': conf.iloc[:, 1] if 'upper' not in conf.columns else conf['upper']
    })
    
    print(f"\nUsing: {best_model_name}")
    print(forecast_df.to_string(index=False))
    forecast_df.to_csv(Config.OUTPUT_DIR / 'phase3_forecast_12m.csv', index=False)
    
    # Forecast by make
    print("\n" + "="*70)
    print("FORECAST BY TOP MAKES")
    print("="*70)
    
    by_make_forecasts = []
    for make, series in by_make.items():
        try:
            arima = ARIMAForecaster(auto_optimize=True)
            arima.fit(series)
            forecast, _ = arima.forecast(Config.FORECAST_HORIZON)
            
            by_make_forecasts.append({
                'make': make,
                'current_avg_12m': series.tail(12).mean(),
                'forecast_next_12m_avg': forecast.mean(),
                'forecast_trend': 'Up' if forecast.mean() > series.tail(12).mean() else 'Down'
            })
            print(f"  {make:20} → {forecast.mean():.0f} avg (trend: {by_make_forecasts[-1]['forecast_trend']})")
        except Exception as e:
            print(f"  {make:20} → Failed: {e}")
    
    by_make_df = pd.DataFrame(by_make_forecasts)
    by_make_df.to_csv(Config.OUTPUT_DIR / 'phase3_forecast_by_make.csv', index=False)
    
    # Visualizations
    print("\n" + "="*70)
    print("GENERATING VISUALIZATIONS")
    print("="*70)
    
    Visualizer.plot_model_comparison(train_series, test_series, ensemble.test_results)
    Visualizer.plot_forecast_horizon(monthly_series, best_model, Config.FORECAST_HORIZON, best_model_name)
    
    # Summary report
    print("\n" + "="*70)
    print("PHASE 3 COMPLETE ✓")
    print("="*70)
    
    summary = {
        'execution_date': datetime.now().isoformat(),
        'data_period': f"{monthly_series.index.min().date()} to {monthly_series.index.max().date()}",
        'observations': len(monthly_series),
        'best_model': best_model_name,
        'best_model_mae': float(comparison_df.iloc[0]['MAE']),
        'forecast_horizon': Config.FORECAST_HORIZON,
        'forecast_average': float(forecast_df['forecast'].mean()),
        'files_created': [
            'phase3_model_comparison.png',
            f'phase3_{best_model_name.lower()}_forecast.png',
            'phase3_model_comparison.csv',
            'phase3_forecast_12m.csv',
            'phase3_forecast_by_make.csv'
        ]
    }
    
    with open(Config.RESULTS_DIR / 'phase3_summary.json', 'w') as f:
        json.dump(summary, f, indent=2)
    

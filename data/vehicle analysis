class ProphetForecaster:
    """Facebook Prophet - handles multiple seasonalities well"""
    
    def __init__(self):
        if not PROPHET_AVAILABLE:
            raise ImportError("fbprophet not installed. Run: pip install fbprophet")
        
        self.model = None
        self.history = {}
    
    def fit(self, series, interval_width=0.95):
        """Fit Prophet model"""
        # Convert to Prophet format
        df = pd.DataFrame({
            'ds': series.index,
            'y': series.values
        })
        
        self.model = Prophet(
            interval_width=interval_width,
            yearly_seasonality=True,
            weekly_seasonality=False,
            daily_seasonality=False
        )
        
        # Suppress logging
        import logging
        logging.getLogger('fbprophet').setLevel(logging.WARNING)
        
        self.model.fit(df)
        
        print(f"  ✓ Prophet model fitted")
        return self.model
    
    def forecast(self, steps):
        """Generate forecast"""
        future = self.model.make_future_dataframe(periods=steps, freq='MS')
        forecast = self.model.predict(future)
        
        # Extract forecast for next periods only
        forecast = forecast.tail(steps)
        
        pred = forecast['yhat'].values
        conf_lower = forecast['yhat_lower'].values
        conf_upper = forecast['yhat_upper'].values
        
        return pred, conf_lower, conf_upper
    
    def backtest_walk_forward(self, series, window=6):
        """Walk-forward backtest"""
        print(f"\n📊 Prophet Walk-Forward Backtest (window={window}m)...")
        
        predictions = []
        actuals = []
        
        n_obs = len(series)
        n_tests = (n_obs - window) // window
        
        for i in range(n_tests):
            train_end = (i + 1) * window
            test_start = train_end
            test_end = test_start + window
            
            if test_end > n_obs:
                break
            
            train = series[:train_end]
            test = series[test_start:test_end]
            
            try:
                prophet = ProphetForecaster()
                prophet.fit(train)
                pred, _, _ = prophet.forecast(window)
                
                predictions.extend(pred)
                actuals.extend(test.values)
            except:
                continue
        
        if predictions:
            mae = mean_absolute_error(actuals, predictions)
            rmse = np.sqrt(mean_squared_error(actuals, predictions))
            mape = mean_absolute_percentage_error(actuals, predictions)
            
            self.history['backtest'] = {
                'mae': mae,
                'rmse': rmse,
                'mape': mape,
                'n_predictions': len(predictions)
            }
            
            print(f"  MAE: {mae:.0f} | RMSE: {rmse:.0f} | MAPE: {mape:.2%}")
        
        return predictions, actuals


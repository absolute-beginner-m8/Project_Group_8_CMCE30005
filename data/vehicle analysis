class Visualizer:
    """Create publication-ready visualizations"""
    
    @staticmethod
    def plot_model_comparison(train_series, test_series, models_results):
        """Plot actual vs predictions for all models"""
        fig, ax = plt.subplots(figsize=(14, 6))
        
        # Actual data
        ax.plot(train_series.index, train_series.values, 'o-', linewidth=2, 
               label='Training Data', color='steelblue', markersize=4)
        ax.plot(test_series.index, test_series.values, 'o-', linewidth=2,
               label='Actual Test Data', color='darkblue', markersize=4)
        
        # Model predictions
        colors = {'ARIMA': 'coral', 'Prophet': 'seagreen', 'XGBoost': 'purple'}
        for model_name, results in models_results.items():
            ax.plot(test_series.index, results['predictions'], '--', linewidth=2,
                   label=f"{model_name} Forecast", color=colors.get(model_name, 'gray'))
        
        ax.set_title('Model Comparison: Transfer Volume Forecasts', fontsize=14, fontweight='bold')
        ax.set_xlabel('Date')
        ax.set_ylabel('Monthly Transfers')
        ax.legend(loc='best')
        ax.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.savefig(Config.PLOTS_DIR / 'phase3_model_comparison.png', dpi=300, bbox_inches='tight')
        print(f"✓ Saved: phase3_model_comparison.png")
        plt.close()
    
    @staticmethod
    def plot_forecast_horizon(series, model, steps=12, model_name='ARIMA'):
        """Plot historical data + forecast + confidence intervals"""
        fig, ax = plt.subplots(figsize=(14, 6))
        
        # Historical data
        ax.plot(series.index, series.values, 'o-', linewidth=2, label='Historical Data', markersize=5)
        
        # Forecast
        forecast, conf = model.forecast(steps)
        future_dates = pd.date_range(start=series.index[-1] + pd.DateOffset(months=1), 
                                     periods=steps, freq='MS')
        
        ax.plot(future_dates, forecast, 'o--', linewidth=2, label='Forecast', color='coral', markersize=5)
        
        # Confidence interval
        ax.fill_between(future_dates, conf.iloc[:, 0], conf.iloc[:, 1], 
                       alpha=0.2, color='coral', label='95% Confidence Interval')
        
        ax.axvline(x=series.index[-1], color='red', linestyle=':', linewidth=2, label='Forecast Start')
        
        ax.set_title(f'{model_name} - 12-Month Forecast', fontsize=14, fontweight='bold')
        ax.set_xlabel('Date')
        ax.set_ylabel('Monthly Transfers')
        ax.legend(loc='best')
        ax.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.savefig(Config.PLOTS_DIR / f'phase3_{model_name.lower()}_forecast.png', 
                   dpi=300, bbox_inches='tight')
        print(f"✓ Saved: phase3_{model_name.lower()}_forecast.png")
        plt.close()


class ARIMAForecaster:
    """Auto-regressive Integrated Moving Average model"""
    
    def __init__(self, order=None, auto_optimize=True):
        self.order = order
        self.auto_optimize = auto_optimize
        self.model = None
        self.fitted = None
        self.history = {}
    
    def find_best_order(self, series, max_p=3, max_d=2, max_q=3):
        """Grid search for best (p,d,q) order"""
        print(f"\n🔍 Optimizing ARIMA parameters...")
        
        best_aic = np.inf
        best_order = None
        
        import itertools
        
        for p, d, q in itertools.product(range(max_p), range(max_d), range(max_q)):
            try:
                model = ARIMA(series, order=(p, d, q))
                fitted = model.fit()
                
                if fitted.aic < best_aic:
                    best_aic = fitted.aic
                    best_order = (p, d, q)
            except:
                continue
        
        print(f"  Best order: ARIMA{best_order} (AIC: {best_aic:.2f})")
        self.order = best_order
        
        return best_order
    
    def fit(self, train_series):
        """Fit ARIMA model"""
        if self.auto_optimize and self.order is None:
            self.find_best_order(train_series)
        
        self.model = ARIMA(train_series, order=self.order)
        self.fitted = self.model.fit()
        
        self.history = {
            'aic': self.fitted.aic,
            'bic': self.fitted.bic,
            'order': self.order
        }
        
        print(f"  ✓ ARIMA{self.order} fitted")
        return self.fitted
    
    def forecast(self, steps):
        """Generate forecast"""
        forecast_result = self.fitted.get_forecast(steps=steps)
        forecast = forecast_result.predicted_mean
        conf_int = forecast_result.conf_int()
        
        return forecast, conf_int
    
    def backtest_walk_forward(self, series, window=6):
        """Walk-forward backtest"""
        print(f"\n📊 ARIMA Walk-Forward Backtest (window={window}m)...")
        
        predictions = []
        actuals = []
        
        n_obs = len(series)
        n_tests = (n_obs - window) // window  # Number of rolling windows
        
        for i in range(n_tests):
            train_end = (i + 1) * window
            test_start = train_end
            test_end = test_start + window
            
            if test_end > n_obs:
                break
            
            train = series[:train_end]
            test = series[test_start:test_end]
            
            try:
                model = ARIMA(train, order=self.order)
                fitted = model.fit()
                forecast, _ = self.forecast_from_fitted(fitted, window)
                
                predictions.extend(forecast.values)
                actuals.extend(test.values)
            except:
                continue
        
        if predictions:
            mae = mean_absolute_error(actuals, predictions)
            rmse = np.sqrt(mean_squared_error(actuals, predictions))
            mape = mean_absolute_percentage_error(actuals, predictions)
            
            self.history['backtest'] = {
                'mae': mae,
                'rmse': rmse,
                'mape': mape,
                'n_predictions': len(predictions)
            }
            
            print(f"  MAE: {mae:.0f} | RMSE: {rmse:.0f} | MAPE: {mape:.2%}")
        
        return predictions, actuals
    
    @staticmethod
    def forecast_from_fitted(fitted, steps):
        """Forecast from already-fitted model"""
        forecast_result = fitted.get_forecast(steps=steps)
        forecast = forecast_result.predicted_mean
        conf_int = forecast_result.conf_int()
        return forecast, conf_int

